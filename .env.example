# Contraseña del equipo para entrar al panel (ver y editar reportes)
ADMIN_PASSWORD=cambia-esto

# PostgreSQL (DigitalOcean Managed Database). Sin esta variable, en local se usa data/db.json
# DATABASE_URL=postgresql://doadmin:PASSWORD@host:25060/defaultdb?sslmode=require

# Opcional: certificado CA de la base (en DO App Platform: ${db.CA_CERT})
# DATABASE_CA=

# Opcional: secreto para firmar la sesión (si no, se deriva de ADMIN_PASSWORD)
# SESSION_SECRET=
